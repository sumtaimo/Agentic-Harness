{
  "agentic-harness": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ../.harness/hook-session.mjs --agy",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|run_command|Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ../.harness/hook-guard.mjs --agy",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ../.harness/hook-stop.mjs --agy",
        "timeout": 10
      }
    ]
  }
}
