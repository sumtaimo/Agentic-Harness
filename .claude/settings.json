{
  "permissions": {
    "allow": [
      "Bash(node .harness/status.mjs:*)",
      "Bash(node .harness/doctor.mjs:*)",
      "Bash(node .harness/start.mjs --summary:*)",
      "Bash(node .harness/start.mjs --json:*)",
      "Bash(node .harness/hook-session.mjs --brief:*)",
      "Bash(node .harness/usage.mjs:*)",
      "Bash(node .harness/watch.mjs:*)",
      "Bash(node .harness/team.mjs:*)",
      "Bash(node .harness/dispatch.mjs:*)",
      "Bash(node .harness/daemon.mjs)",
      "Bash(node .harness/daemon.mjs --status:*)",
      "Bash(node .harness/daemon.mjs --tick:*)",
      "Bash(node .harness/backlog.mjs list:*)",
      "Bash(node .harness/backlog.mjs overview:*)",
      "Bash(node .harness/backlog.mjs releases:*)",
      "Bash(node .harness/backlog.mjs add:*)",
      "Bash(node .harness/memory.mjs list:*)",
      "Bash(node .harness/memory.mjs context:*)",
      "Bash(node .harness/memory.mjs sessions:*)",
      "Bash(node .harness/memory.mjs remember:*)",
      "Bash(node .harness/memory.mjs learn:*)",
      "Bash(node .harness/visible.mjs brief:*)",
      "Bash(node .harness/visible.mjs assign:*)",
      "Bash(node .harness/visible.mjs verify:*)",
      "Bash(node .harness/visible.mjs visual attach:*)",
      "Bash(node .harness/visible.mjs visual reject:*)",
      "Bash(node .harness/visible.mjs propose:*)",
      "Bash(node .harness/visible.mjs status:*)",
      "Bash(node .harness/visible.mjs report:*)",
      "Bash(node .harness/visible.mjs handoff:*)",
      "Bash(node .harness/sessions.mjs board:*)",
      "Bash(node .harness/sessions.mjs new:*)",
      "Bash(node .harness/sessions.mjs start:*)",
      "Bash(node .harness/sessions.mjs checkpoint:*)",
      "Bash(node .harness/sessions.mjs handoff:*)",
      "Bash(node .harness/sessions.mjs report:*)",
      "Bash(node .harness/feature.mjs new:*)",
      "Bash(node .harness/feature.mjs expand:*)",
      "Bash(node .harness/feature.mjs prompt:*)",
      "Bash(node .harness/feature.mjs show:*)",
      "Bash(node .harness/feature.mjs status:*)",
      "Bash(node .harness/hunt.mjs new:*)",
      "Bash(node .harness/hunt.mjs run:*)",
      "Bash(node .harness/hunt.mjs prompt:*)",
      "Bash(node .harness/hunt.mjs show:*)",
      "Bash(node .harness/hunt.mjs status:*)",
      "Bash(npm test:*)",
      "Bash(node --test:*)"
    ],
    "ask": [
      "Bash(node .harness/visible.mjs rollback:*)",
      "Bash(node .harness/visible.mjs visual confirm:*)",
      "Bash(node .harness/sessions.mjs merge:*)",
      "Bash(node .harness/sessions.mjs cleanup:*)",
      "Edit(.harness/team.json)",
      "Bash(node .harness/team.mjs auto-assign:*)",
      "Bash(node .harness/team.mjs adapt-scopes --apply:*)",
      "Bash(node .harness/daemon.mjs --autonomous:*)",
      "Bash(node .harness/backlog.mjs import:*)",
      "Bash(node .harness/feature.mjs approve:*)",
      "Bash(node .harness/feature.mjs cancel:*)",
      "Bash(node .harness/hunt.mjs approve:*)",
      "Bash(node .harness/hunt.mjs cancel:*)",
      "Bash(node .harness/backlog.mjs approve:*)",
      "Bash(node .harness/backlog.mjs ready:*)",
      "Bash(node .harness/backlog.mjs block:*)",
      "Bash(node .harness/memory.mjs forget:*)",
      "Bash(node .harness/memory.mjs forget-auto:*)",
      "Bash(node .harness/memory.mjs promote:*)",
      "Edit(.harness/charter.md)",
      "Edit(.harness/config.json)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Edit(.harness/releases/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node .harness/hook-session.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .harness/hook-guard.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .harness/hook-stop.mjs"
          }
        ]
      }
    ]
  }
}
