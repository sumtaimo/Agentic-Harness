{
  "maxCycles": 3,
  "workerTimeoutMs": 300000,
  "verifyTimeoutMs": 600000,
  "useGitWorktrees": false,
  "rollbackOnFailure": true,
  "autoGitCommit": false,
  "activeProfile": "auto",
  "autoOrder": [
    "claude",
    "antigravity",
    "orca",
    "gemini",
    "codex"
  ],
  "defaultVerifyCmd": "node -e \"process.exit(0)\"",
  "autonomous": {
    "intervalSeconds": 300
  },
  "planner": {
    "defaultAutoPlan": false,
    "maxWorkers": 4,
    "maxAttempts": 2,
    "maxFilesListed": 400,
    "allowedTools": [
      "Read",
      "Glob",
      "Grep"
    ]
  },
  "memory": {
    "enabled": true,
    "recordSessions": true,
    "autoLessons": true,
    "maxAutoLessons": 10,
    "maxLessonLines": 50,
    "maxContextChars": 6000
  },
  "profiles": {
    "claude": {
      "verified": true,
      "note": "Claude Code headless mode. Prompt goes on stdin. Role tools -> --allowedTools; charter forbiddenPaths/forbiddenTools -> --disallowedTools. CLAUDE.md @imports profile.md + lessons.md, so the harness does not inject those twice.",
      "binary": "claude",
      "args": [
        "-p",
        "--output-format",
        "json",
        "--allowedTools",
        "{allowedTools}",
        "--disallowedTools",
        "{disallowedTools}"
      ],
      "promptVia": "stdin",
      "instructionFile": "CLAUDE.md",
      "allowedTools": [
        "Read",
        "Edit",
        "Write",
        "Glob",
        "Grep",
        "Bash(git:*)",
        "Bash(npm:*)",
        "Bash(node:*)"
      ],
      "useMcp": false,
      "mcpArgs": [
        "--mcp-config",
        "{mcpConfig}"
      ],
      "mcpConfigPath": ".harness/mcp.json"
    },
    "antigravity": {
      "verified": false,
      "note": "UNVERIFIED: flags from the original spec. 'Harness: Doctor' runs 'antigravity --help' and checks every flag below; if any is missing the harness falls back to 'auto'. Prompt goes on stdin; set promptVia to 'arg' (+ '{prompt}' in args) or 'after--' if the real CLI needs it.",
      "binary": "antigravity",
      "args": [
        "--headless",
        "--json"
      ],
      "promptVia": "stdin",
      "allowedTools": [
        "Read",
        "Edit",
        "Write",
        "Bash"
      ]
    },
    "orca": {
      "verified": false,
      "note": "UNVERIFIED: flags from the original spec. Doctor probes 'orca run --help'; falls back to 'auto' if a flag is missing. Prompt goes on stdin.",
      "binary": "orca",
      "args": [
        "run",
        "--non-interactive",
        "--format",
        "json"
      ],
      "promptVia": "stdin",
      "allowedTools": [
        "Read",
        "Edit",
        "Write",
        "Bash"
      ]
    },
    "gemini": {
      "verified": false,
      "note": "UNVERIFIED here (not installed on the test machine). Gemini CLI reads a piped prompt non-interactively; --yolo auto-approves every tool, so only use it in a project you trust.",
      "binary": "gemini",
      "args": [
        "--yolo"
      ],
      "promptVia": "stdin",
      "instructionFile": "GEMINI.md",
      "allowedTools": []
    },
    "codex": {
      "verified": false,
      "note": "UNVERIFIED here (not installed on the test machine). OpenAI Codex CLI; '-' means read the prompt from stdin.",
      "binary": "codex",
      "args": [
        "exec",
        "--full-auto",
        "-"
      ],
      "promptVia": "stdin",
      "allowedTools": []
    }
  }
}
