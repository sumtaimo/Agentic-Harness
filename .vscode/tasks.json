{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Harness: Run (normal, one task now)",
      "detail": "Single direct worker, no planner: fastest and cheapest. Files are restored if the check fails.",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/dispatch.mjs",
        "--mode",
        "normal",
        "--goal",
        "${input:goal}",
        "--files",
        "${input:files}",
        "--check",
        "${input:check}",
        "--wait"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: 1. Start (live screen)",
      "detail": "Starts the background agentic harness and shows its live screen. Starts by itself when the folder opens (after you allow automatic tasks once).",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/daemon.mjs",
        "--watch"
      ],
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false,
        "group": "harness"
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: 2. New task (type what you want)",
      "detail": "Describe the job in plain words. Optionally let the AI planner split it into parallel workers. The harness runs it and checks the result; on failure your files are restored.",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/dispatch.mjs",
        "--goal",
        "${input:goal}",
        "--files",
        "${input:files}",
        "--check",
        "${input:check}",
        "--engine",
        "${input:engine}",
        "--auto-plan",
        "${input:autoplan}",
        "--wait"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: 3. Teach the AI something (remember)",
      "detail": "Save a rule or preference. Every AI working in this folder will follow it.",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/memory.mjs",
        "remember",
        "${input:lesson}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: 4. Show memory",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/memory.mjs",
        "list"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: 5. Status + recent events",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/status.mjs",
        "--log",
        "25"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: Doctor (check my setup)",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/doctor.mjs"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: 6. Start Autonomous Controller (acts on charter.md)",
      "detail": "Wakes on a heartbeat and works through the backlog (the PO_ARCHITECT plans new tasks when it is empty), only if charter.md says autonomous: on. Work is built on its own branches and merged into 'uat' only after the check passes; your folder and main are never touched. You see each agent working live. Stop task 1 first (one controller per folder).",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/daemon.mjs",
        "--autonomous"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "group": "harness"
      },
      "problemMatcher": [],
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Harness: 7. Run Autonomous Controller Tick",
      "detail": "One step of the autonomous controller now: run the next READY backlog item (or let the PO_ARCHITECT plan one). Works whether or not the controller is running.",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/daemon.mjs",
        "--tick"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: 8. View Backlog & Releases",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/backlog.mjs",
        "overview"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: 9. Import New Goal/Backlog with Snapshot",
      "detail": "Replace the backlog (.json), the charter (.md) or the skills (folder). The old version is saved to .harness/releases/ first; memory is kept.",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/backlog.mjs",
        "import",
        "${input:importPath}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: 10. Add a goal to the backlog",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/backlog.mjs",
        "add",
        "${input:goal}",
        "--files",
        "${input:files}",
        "--status",
        "${input:backlogStatus}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: Run Self-Test Cycle",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/daemon.mjs",
        "--self-test"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: AI tools (allow once)",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/engines.mjs"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "Harness: Usage (calls, tokens, cost)",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/usage.mjs"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Harness: Usage (last 30 days)",
      "detail": "Show 30-day AI quota, call counts, tokens, cost, and daily cap warnings.",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/usage.mjs",
        "--days",
        "30"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Harness: Start Menu (interactive)",
      "detail": "Open the interactive numbered menu + live overview banner for every harness workflow.",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/start.mjs"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "Harness: Handoff / Inspect unfinished run",
      "detail": "Inspect an unfinished or stopped editor run, partial changes on disk, and print a continuation prompt.",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/visible.mjs",
        "handoff"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: Resume unfinished run in terminal",
      "detail": "Continue and verify an unfinished editor run headlessly in Terminal with your selected engine, keeping partial edits.",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/dispatch.mjs",
        "--resume-visible",
        "--engine",
        "${input:engine}",
        "--wait"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: Session Board (child sessions)",
      "detail": "List child task branches, DONE tasks ready to merge, and any HIGH RISK warnings.",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/sessions.mjs",
        "board"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: Session Checkpoint (save WIP)",
      "detail": "Commit dirty non-secret WIP on a child session branch without marking it DONE.",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/sessions.mjs",
        "checkpoint",
        "${input:sessionId}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: Session Handoff / Inspect",
      "detail": "Inspect a child session branch, commits, dirty WIP, and get a continuation prompt / --cwd command.",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/sessions.mjs",
        "handoff",
        "${input:sessionId}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: Session Merge DONE task",
      "detail": "Run the project check in a temp worktree, merge a DONE child task into base, and clean up its branch/worktree.",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/sessions.mjs",
        "merge",
        "${input:sessionId}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: Team (show setup & budgets)",
      "detail": "Show the agent team hierarchy, roles, engines, file scopes, and budgets.",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/team.mjs",
        "show"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: Team validate",
      "detail": "Validate .harness/team.json scopes, charter boundaries, and budgets (exit 0 = valid).",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/team.mjs",
        "validate"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: Team auto-assign (route AI engines)",
      "detail": "Detect installed AI CLIs on this machine and route planning/coding/QA roles in .harness/team.json.",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/team.mjs",
        "auto-assign"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: Team sync-agents",
      "detail": "Regenerate .claude/agents/lead-*.md named agents from .harness/team.json and .harness/roles/.",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/team.mjs",
        "sync-agents"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: Approve held backlog item",
      "detail": "Approve a big backlog task held as Needs OK so Autopilot can run it.",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/backlog.mjs",
        "approve",
        "${input:backlogId}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Harness: Local Web UI (dashboard)",
      "detail": "Start the read-only local web dashboard on http://127.0.0.1:4173/ (status, backlog, quota, sessions, live logs).",
      "type": "process",
      "command": "node",
      "args": [
        ".harness/ui.mjs"
      ],
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "group": "harness"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "goal",
      "type": "promptString",
      "description": "What should the AI do? Write it like you would tell a person."
    },
    {
      "id": "files",
      "type": "promptString",
      "description": "Which files/folders may it change? (comma separated, e.g. src/ — leave empty to let it decide; needed for automatic undo)",
      "default": ""
    },
    {
      "id": "check",
      "type": "promptString",
      "description": "Command that proves it worked, e.g. npm test (leave empty = pick from package.json check/typecheck/test/build/lint; if none, NO real check)",
      "default": ""
    },
    {
      "id": "engine",
      "type": "pickString",
      "description": "Which AI engine?",
      "options": [
        "auto",
        "claude",
        "antigravity",
        "codex"
      ],
      "default": "auto"
    },
    {
      "id": "autoplan",
      "type": "pickString",
      "description": "Split into parallel AI workers automatically? (AI planner)",
      "options": [
        "no",
        "yes"
      ],
      "default": "no"
    },
    {
      "id": "lesson",
      "type": "promptString",
      "description": "What should every AI remember? (e.g. Always explain changes in simple English)"
    },
    {
      "id": "importPath",
      "type": "promptString",
      "description": "Path of the new backlog .json, charter .md, or skills folder (e.g. .harness/examples/backlog.sample.json)"
    },
    {
      "id": "backlogStatus",
      "type": "pickString",
      "description": "Ready to run now, or just an idea for the PO to groom later?",
      "options": [
        "READY",
        "BACKLOG"
      ],
      "default": "READY"
    },
    {
      "id": "backlogId",
      "type": "promptString",
      "description": "Backlog item ID waiting for approval (see 'Harness: 8. View Backlog & Releases' or hook summary)"
    },
    {
      "id": "sessionId",
      "type": "promptString",
      "description": "Child task ID on the session board (e.g. FEAT-1; leave empty on handoff to auto-detect)",
      "default": ""
    }
  ]
}
