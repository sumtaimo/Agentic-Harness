{
  "name": "agentic-harness",
  "version": "1.0.4",
  "private": true,
  "description": "Zero-dependency agentic workflow harness template (no packages to install)",
  "bin": {
    "agentic-harness": "./install.mjs"
  },
  "scripts": {
    "test": "node test/run-tests.mjs && node --test test/engine-probe.test.mjs",
    "test:live": "node test/live-e2e.mjs",
    "demo": "node examples/make-demo.mjs",
    "run": "node .harness/dispatch.mjs --mode normal --wait",
    "normal": "node .harness/dispatch.mjs --mode normal --wait",
    "auto": "node .harness/daemon.mjs --autonomous",
    "autopilot": "node .harness/daemon.mjs --autonomous",
    "status": "node .harness/status.mjs",
    "doctor": "node .harness/doctor.mjs",
    "usage": "node .harness/usage.mjs",
    "engines": "node .harness/engines.mjs",
    "audit": "node test/audit.mjs"
  },
  "author": "TAIMO",
  "license": "MIT"
}
